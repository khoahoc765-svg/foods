<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="flex-1 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md bg-surface rounded-[2rem] border-2 border-line shadow-soft p-7 sm:p-8">
    <div class="text-center">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-accent-soft flex items-center justify-center text-3xl">🍡</div>
      <h1 class="mt-4 text-2xl font-black text-ink font-display">Đăng nhập</h1>
      <p class="text-sm text-muted mt-1">Đăng nhập để lưu quán yêu thích của bạn</p>
    </div>

    <% if (error) { %>
      <div class="mt-5 px-4 py-3 rounded-2xl bg-brand/10 border border-brand/30 text-brand text-sm font-bold">⚠️ <%= error %></div>
    <% } %>

    <form action="/auth/login" method="POST" class="mt-6 space-y-4">
      <label class="block">
        <span class="block text-xs font-extrabold text-muted mb-1">Email</span>
        <input type="email" name="email" value="<%= form.email %>" required autocomplete="email" placeholder="ban@gmail.com"
          class="w-full px-4 py-3 rounded-2xl border border-line bg-bg text-ink font-semibold focus:outline-none focus:border-accent">
      </label>
      <label class="block">
        <span class="block text-xs font-extrabold text-muted mb-1">Mật khẩu</span>
        <input type="password" name="password" required autocomplete="current-password" placeholder="••••••"
          class="w-full px-4 py-3 rounded-2xl border border-line bg-bg text-ink font-semibold focus:outline-none focus:border-accent">
      </label>
      <button type="submit" class="w-full py-3 rounded-2xl btn-accent font-black shadow-soft transition">Đăng nhập</button>
    </form>

    <div class="mt-5 p-3.5 rounded-2xl bg-line/30 border border-line text-xs text-muted font-semibold space-y-0.5">
      <p class="font-extrabold text-ink">💡 Tài khoản mẫu (sau khi chạy seed):</p>
      <p>Admin: <strong class="text-ink">admin@gmail.com</strong> / 123456</p>
      <p>User: <strong class="text-ink">minhanh@gmail.com</strong> / 123456</p>
    </div>

    <p class="mt-5 text-center text-sm text-muted">
      Chưa có tài khoản? <a href="/auth/register" class="font-extrabold text-accent hover:underline">Đăng ký ngay</a>
    </p>
  </div>
</main>

<%- include('../partials/footer') %>
