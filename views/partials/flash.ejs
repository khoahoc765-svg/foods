<% if (flash) { %>
  <div class="wrap" style="margin-top: 1rem;" data-flash>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.75rem 1.25rem;border:2px solid var(--accent);border-radius:var(--radius);background:var(--surface);font-weight:700;" role="status">
      <span><%= flash.message %></span>
      <button type="button" class="btn" style="min-height:34px;padding:.25rem .75rem;font-size:.875rem;" data-flash-close aria-label="Đóng thông báo">Đóng</button>
    </div>
  </div>
<% } %>
