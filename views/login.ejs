<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập - Hôm Nay Ăn Gì</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-rose-50/40 min-h-screen font-sans text-slate-700 flex flex-col">
  <nav class="bg-white shadow-sm border-b border-rose-100 px-6 py-4 flex justify-between items-center">
    <a href="/" class="flex items-center space-x-2">
      <span class="text-2xl">🍜</span>
      <span class="text-xl font-bold text-rose-500">Hôm Nay Ăn Gì</span>
    </a>
    <a href="/" class="text-sm font-medium text-slate-500 hover:text-rose-500 transition">← Về trang chủ</a>
  </nav>

  <main class="flex-1 flex items-center justify-center p-6">
    <div class="bg-white max-w-md w-full rounded-2xl shadow-sm border border-rose-100 p-8 space-y-6">
      <div class="text-center">
        <h1 class="text-2xl font-bold text-slate-800">Đăng nhập</h1>
        <p class="text-sm text-slate-400 mt-1">Đăng nhập để vào hệ thống hoặc trang Quản trị viên</p>
      </div>

      <% if (error) { %>
        <div class="bg-rose-50 border border-rose-200 text-rose-600 text-sm px-4 py-3 rounded-xl">
          <%= error %>
        </div>
      <% } %>

      <!-- Gợi ý tài khoản mẫu để test nhanh -->
      <div class="bg-amber-50/80 border border-amber-200/80 rounded-xl p-3.5 text-xs text-slate-600 space-y-1">
        <p class="font-semibold text-amber-700">💡 Tài khoản có sẵn để test nhanh:</p>
        <p>• <strong>Admin:</strong> <code>admin@homnayangi.vn</code> / Mật khẩu: <code>admin123</code></p>
        <p>• <strong>User:</strong> <code>user@homnayangi.vn</code> / Mật khẩu: <code>123456</code></p>
      </div>

      <form action="/login" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Email</label>
          <input type="email" name="email" value="admin@homnayangi.vn" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-400">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Mật khẩu</label>
          <input type="password" name="password" value="admin123" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-rose-400">
        </div>
        <button type="submit" class="w-full bg-rose-400 hover:bg-rose-500 text-white font-semibold py-2.5 px-4 rounded-xl text-sm transition">
          Đăng nhập
        </button>
      </form>

      <p class="text-center text-sm text-slate-500">
        Chưa có tài khoản? <a href="/register" class="text-rose-500 font-medium hover:underline">Đăng ký ngay</a>
      </p>
    </div>
  </main>
</body>
</html>
