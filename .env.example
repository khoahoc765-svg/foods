# Sao chép file này thành .env rồi chỉnh theo máy của bạn
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/hom_nay_an_gi
SESSION_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-dai

# true  = nếu MongoDB không kết nối được, lưu dữ liệu dự phòng vào data/*.json
# false = bắt buộc kết nối MongoDB; server sẽ dừng nếu kết nối thất bại
USE_MEMORY_DB_FALLBACK=true
